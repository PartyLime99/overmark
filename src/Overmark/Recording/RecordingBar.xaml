<Window x:Class="Overmark.Recording.RecordingBar"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overmark recording"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Opacity="0">

    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="8,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow. -->
    <Border Margin="10" CornerRadius="8" Background="#F2202020" BorderBrush="#E5484D" BorderThickness="1" Padding="8,4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#E5484D" Stroke="#E5484D" StrokeThickness="1.5" VerticalAlignment="Center" Margin="4,0,8,0" />
            <TextBlock x:Name="TimeText" Text="0:00" Foreground="White" FontFamily="Segoe UI" FontSize="13" MinWidth="40" VerticalAlignment="Center" />
            <Button x:Name="PauseButton" Style="{StaticResource BarButton}" ToolTip="Pause">
                <TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" />
            </Button>
            <Button x:Name="StopButton" Style="{StaticResource BarButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Foreground="#FF6B70" />
                    <TextBlock Text="Stop" FontFamily="Segoe UI" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="DiscardButton" Style="{StaticResource BarButton}" ToolTip="Stop and throw the recording away">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
            </Button>
        </StackPanel>
    </Border>
</Window>
