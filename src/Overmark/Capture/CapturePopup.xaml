<Window x:Class="Overmark.Capture.CapturePopup"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overmark"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        Foreground="#16191D"
        UseLayoutRounding="True"
        Opacity="0"
        Left="-32000"
        Top="-32000">

    <Window.Resources>
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A row in the action list: icon, name, and a quieter note on the right. -->
        <Style x:Key="ActionRow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#16191D" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="10" Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F0F2F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E4E8EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete is red, and redder under the mouse, so it's clear this one throws the capture away. -->
        <Style x:Key="DeleteRow" TargetType="Button" BasedOn="{StaticResource ActionRow}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="10" Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FDECEC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F9D7D5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowNote" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#5A626D" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#4A525C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Width="28" Height="28" CornerRadius="9" Background="#EBFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow. -->
    <Border Margin="16" CornerRadius="20" Background="White" Padding="8" Width="290">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Border x:Name="PreviewFrame" CornerRadius="13" Background="#F4F6F8" BorderBrush="#E3E7EC" BorderThickness="1" Cursor="Hand"
                        ToolTip="Click to open it, or drag it into another app">
                    <Image x:Name="Preview" MaxHeight="170" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center">
                        <Image.Clip>
                            <RectangleGeometry x:Name="PreviewClip" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" ToolTip="Close">
                    <Path Style="{StaticResource Icon}" Width="12" Height="12" Data="M4.5,4.5 L13.5,13.5 M13.5,4.5 L4.5,13.5" />
                </Button>
            </Grid>

            <StackPanel Margin="10,10,10,6">
                <TextBlock x:Name="Heading" FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="Details" FontSize="12" Foreground="#5A626D" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <Button x:Name="EditButton" Style="{StaticResource ActionRow}">
                <DockPanel>
                    <TextBlock Style="{StaticResource RowNote}" Text="or click the picture" />
                    <Path x:Name="EditIcon" Style="{StaticResource Icon}" Data="M3,15 L3.5,12 L12,3.5 L14.5,6 L6,14.5 Z M10.5,5 L13,7.5" />
                    <TextBlock x:Name="EditLabel" Style="{StaticResource RowName}" Text="Edit" />
                </DockPanel>
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource ActionRow}">
                <DockPanel>
                    <Path Style="{StaticResource Icon}" Data="M11,2 L16,7 L13.5,8 L10.5,11 L11,14.5 L3.5,7 L7,7.5 L10,4.5 Z M7,11 L2.5,15.5" />
                    <TextBlock Style="{StaticResource RowName}" Text="Pin to the screen" />
                </DockPanel>
            </Button>
            <Button x:Name="RemoveWhiteButton" Style="{StaticResource ActionRow}" ToolTip="Copies it again with the white background see-through; the saved file stays as it is">
                <DockPanel>
                    <!-- The editor's see-through icon, drawn on its 18-pixel grid and shrunk to this list's size. -->
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Path Style="{StaticResource Icon}" Width="18" Height="18" Stretch="None" Data="M2.5,2.5 H15.5 V15.5 H2.5 Z" />
                            <Path Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Opacity="0.5"
                                  Data="M2.5,2.5 h3.25 v3.25 h-3.25 Z M9,2.5 h3.25 v3.25 h-3.25 Z M5.75,5.75 h3.25 v3.25 h-3.25 Z M12.25,5.75 h3.25 v3.25 h-3.25 Z M2.5,9 h3.25 v3.25 h-3.25 Z M9,9 h3.25 v3.25 h-3.25 Z M5.75,12.25 h3.25 v3.25 h-3.25 Z M12.25,12.25 h3.25 v3.25 h-3.25 Z" />
                        </Grid>
                    </Viewbox>
                    <TextBlock Style="{StaticResource RowName}" Text="Remove background and copy" />
                </DockPanel>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource DeleteRow}" ToolTip="Moves the file to the Recycle Bin and takes it off the clipboard">
                <DockPanel>
                    <TextBlock Style="{StaticResource RowNote}" Text="to the Recycle Bin" Foreground="#B42318" />
                    <Path Style="{StaticResource Icon}" Data="M3,5 H15 M7,5 V3 H11 V5 M4.5,5 L5.5,16 H12.5 L13.5,5 M7.5,8 V13 M10.5,8 V13" />
                    <TextBlock Style="{StaticResource RowName}" Text="Delete" />
                </DockPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
