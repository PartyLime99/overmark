<Window x:Class="Overmark.Capture.CapturePopup"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overmark"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        Opacity="0"
        Left="-32000"
        Top="-32000">

    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow. -->
    <Border Margin="14" CornerRadius="10" Background="#F2202020" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" />
        </Border.Effect>
        <StackPanel Width="300">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" ToolTip="Pin to the screen">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" ToolTip="Close">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="Heading" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Border x:Name="PreviewFrame" Margin="0,8" CornerRadius="6" Background="#18FFFFFF" Cursor="Hand" ToolTip="Click to edit, or drag into another app">
                <Image x:Name="Preview" MaxHeight="190" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
            </Border>

            <TextBlock x:Name="Details" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="Hint" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="11" Margin="0,2,0,0"
                       Text="Click to edit  ·  drag into another app" />
        </StackPanel>
    </Border>
</Window>
