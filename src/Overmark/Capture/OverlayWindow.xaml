<Window x:Class="Overmark.Capture.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:Overmark.Capture"
        Title="Overmark capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="None">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The frozen screen, shown at exactly one image pixel per screen pixel. -->
        <Image x:Name="FrozenImage"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <capture:OverlayCanvas x:Name="Overlay" />

        <Border x:Name="Toolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Padding="4"
                CornerRadius="10"
                Background="#F0202020"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                Cursor="Arrow"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LastRegionButton" Style="{StaticResource ToolbarButton}" ToolTip="Capture the last region again (L)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                        <TextBlock Style="{StaticResource Caption}" Text="Last region" />
                    </StackPanel>
                </Button>
                <Button x:Name="FullScreenButton" Style="{StaticResource ToolbarButton}" ToolTip="Capture this whole monitor (F)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" />
                        <TextBlock Style="{StaticResource Caption}" Text="Full screen" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordButton" Style="{StaticResource ToolbarButton}" ToolTip="Record a video of an area instead of a screenshot (R)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="11" Height="11" Fill="#E5484D" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecordCaption" Style="{StaticResource Caption}" Text="Record" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="4,6" Fill="#40FFFFFF" />
                <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" ToolTip="Settings">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource ToolbarButton}" ToolTip="Cancel (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
