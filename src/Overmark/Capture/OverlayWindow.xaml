<Window x:Class="Overmark.Capture.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:Overmark.Capture"
        Title="Overmark capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Black"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="None">

    <Window.Resources>
        <!-- A toolbar button: icon over a short label, with its key in the corner. -->
        <Style x:Key="ToolbarButton" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3A414B" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" CornerRadius="13" Background="{TemplateBinding Background}" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="Key" Text="{TemplateBinding Tag}" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Normal"
                                       Foreground="#8A929C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F0F2F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#16191D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Screenshot or video: the chosen one is filled in (red for video). -->
        <Style x:Key="ModeButton" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" CornerRadius="13" Background="Transparent" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="Key" Text="{TemplateBinding Tag}" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Normal"
                                       Foreground="#8A929C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F0F2F5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Key" Property="Foreground" Value="#C9CED6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Fill" Value="#E3E7EC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The frozen screen, shown at exactly one image pixel per screen pixel. -->
        <Image x:Name="FrozenImage"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <capture:OverlayCanvas x:Name="Overlay" />

        <!-- Bottom-centre of the monitor, just above the taskbar (the margin is set when the window is placed). -->
        <Border x:Name="Toolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,22"
                Padding="6"
                CornerRadius="22"
                Background="White"
                Cursor="Arrow"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.35" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ScreenshotButton" Style="{StaticResource ModeButton}" Background="#16191D" ToolTip="Take a screenshot of what you pick">
                    <StackPanel>
                        <Path Style="{StaticResource Icon}" Data="M2,5 V15 H16 V5 H12.5 L11,3 H7 L5.5,5 Z M9,7.5 A2.5,2.5 0 1 0 9.01,7.5 Z" />
                        <TextBlock Style="{StaticResource Label}" Text="Photo" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="RecordButton" Style="{StaticResource ModeButton}" Background="#D93036" Tag="R" ToolTip="Record a video of what you pick instead (R)">
                    <StackPanel>
                        <Grid Width="18" Height="18" HorizontalAlignment="Center">
                            <Ellipse x:Name="RecordDot" Width="12" Height="12" Fill="#E5484D" />
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Video" />
                    </StackPanel>
                </ToggleButton>
                <Rectangle Style="{StaticResource Divider}" />
                <Button x:Name="LastRegionButton" Style="{StaticResource ToolbarButton}" Tag="L" ToolTip="Capture the last region again (L)">
                    <StackPanel>
                        <Path Style="{StaticResource Icon}" Data="M2,6 V2 H6 M16,12 V16 H12 M12.5,5.5 A4,4 0 1 0 13.5,9.5 M13.5,3 V6 H10.5" />
                        <TextBlock Style="{StaticResource Label}" Text="Last" />
                    </StackPanel>
                </Button>
                <Button x:Name="FullScreenButton" Style="{StaticResource ToolbarButton}" Tag="F" ToolTip="Capture this whole monitor (F)">
                    <StackPanel>
                        <Path Style="{StaticResource Icon}" Data="M2,3 H16 V13 H2 Z M6.5,16 H11.5 M9,13 V16" />
                        <TextBlock Style="{StaticResource Label}" Text="Full" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Divider}" />
                <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" ToolTip="Settings">
                    <StackPanel>
                        <Path Style="{StaticResource Icon}" Data="M3,5 H15 M3,13 H15 M6.5,3 V7 M11.5,11 V15" />
                        <TextBlock Style="{StaticResource Label}" Text="Settings" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource ToolbarButton}" ToolTip="Cancel (Esc)">
                    <StackPanel>
                        <Path Style="{StaticResource Icon}" Data="M4.5,4.5 L13.5,13.5 M13.5,4.5 L4.5,13.5" />
                        <TextBlock Style="{StaticResource Label}" Text="Esc" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
