<Window x:Class="Overmark.Editor.EditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Overmark.Editor"
        Title="Overmark"
        Width="1100"
        Height="750"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C"
        Icon="pack://application:,,,/Overmark;component/Assets/Overmark.ico"
        UseLayoutRounding="True">

    <Window.Resources>
        <ControlTemplate x:Key="FlatToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="#4DFFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SwatchTemplate" TargetType="RadioButton">
            <Border x:Name="Ring" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" Padding="2" Background="Transparent">
                <Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Ring" Property="BorderBrush" Value="#66FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Tool" TargetType="RadioButton">
            <Setter Property="Template" Value="{StaticResource FlatToggleTemplate}" />
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Template" Value="{StaticResource FlatToggleTemplate}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Fill" Value="#44FFFFFF" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Foreground="#CCFFFFFF" Margin="0,0,10,0" />
                    <Button x:Name="PinButton" Style="{StaticResource Action}" ToolTip="Pin to the screen: keep it on top of everything">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" />
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource Action}" ToolTip="Copy to the clipboard (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                            <TextBlock Style="{StaticResource Caption}" Text="Copy" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource Action}" ToolTip="Save over the capture file (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                            <TextBlock Style="{StaticResource Caption}" Text="Save" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <RadioButton x:Name="FreehandTool" Style="{StaticResource Tool}" ToolTip="Freehand (P)">
                        <Path Style="{StaticResource Icon}" Data="M3,13 C5,5 8,15 10,9 C11,6 13,5 15,4" />
                    </RadioButton>
                    <RadioButton x:Name="LineTool" Style="{StaticResource Tool}" ToolTip="Line (L). Hold Shift for straight angles.">
                        <Path Style="{StaticResource Icon}" Data="M3,15 L15,3" />
                    </RadioButton>
                    <RadioButton x:Name="ArrowTool" Style="{StaticResource Tool}" ToolTip="Arrow (A). Hold Shift for straight angles.">
                        <Path Style="{StaticResource Icon}" Data="M3,15 L14,4 M8,4 L14,4 L14,10" />
                    </RadioButton>
                    <RadioButton x:Name="CurveTool" Style="{StaticResource Tool}" ToolTip="Curve (C). Drag a line, then drag the handle in its middle to bend it. Enter finishes it.">
                        <Path Style="{StaticResource Icon}" Data="M3,15 Q4,3 15,4" />
                    </RadioButton>
                    <RadioButton x:Name="RectangleTool" Style="{StaticResource Tool}" ToolTip="Rectangle (R). Hold Shift for a square.">
                        <Path Style="{StaticResource Icon}" Data="M3,4 H15 V14 H3 Z" />
                    </RadioButton>
                    <RadioButton x:Name="EllipseTool" Style="{StaticResource Tool}" ToolTip="Circle (O). Hold Shift for a perfect circle.">
                        <Path Style="{StaticResource Icon}" Data="M2.5,9 A6.5,5.5 0 1 1 15.5,9 A6.5,5.5 0 1 1 2.5,9 Z" />
                    </RadioButton>
                    <RadioButton x:Name="HighlighterTool" Style="{StaticResource Tool}" ToolTip="Highlighter (H). Hold Shift for a straight line.">
                        <Path Style="{StaticResource Icon}" Data="M2,9 H16" StrokeThickness="7" Opacity="0.6" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                    </RadioButton>
                    <RadioButton x:Name="EraserTool" Style="{StaticResource Tool}" ToolTip="Eraser (E). Click or drag across marks to remove them.">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" />
                    </RadioButton>
                    <RadioButton x:Name="CropTool" Style="{StaticResource Tool}" ToolTip="Crop (X). Drag a box, then press Enter.">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                    </RadioButton>
                    <ToggleButton x:Name="ArrowheadToggle" Style="{StaticResource Toggle}" ToolTip="Arrowhead on curves" Visibility="Collapsed">
                        <Path Style="{StaticResource Icon}" Data="M3,15 Q4,5 13,4 M10,1.5 L14,4 L10,6.5" />
                    </ToggleButton>

                    <Rectangle Style="{StaticResource Divider}" />
                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="CustomColourButton" Style="{StaticResource Action}" ToolTip="Pick a custom colour (9 selects it afterwards)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" />
                    </Button>

                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid Width="32" Height="36" ToolTip="Current colour and thickness">
                        <Ellipse x:Name="ThicknessPreview" Width="5" Height="5" Fill="White" Stroke="#66FFFFFF" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="ThicknessSlider" Width="130" VerticalAlignment="Center" Focusable="False"
                            Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip="Thickness. [ and ] change it too." />
                    <TextBlock x:Name="ThicknessText" Style="{StaticResource Caption}" Foreground="#CCFFFFFF" MinWidth="38" Margin="8,0,0,0" />

                    <Rectangle Style="{StaticResource Divider}" />
                    <Button x:Name="UndoButton" Style="{StaticResource Action}" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource Action}" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                    </Button>

                    <Rectangle Style="{StaticResource Divider}" />
                    <Button x:Name="FitButton" Style="{StaticResource Action}" ToolTip="Fit to the window (Ctrl+0)">
                        <TextBlock Style="{StaticResource Caption}" Text="Fit" />
                    </Button>
                    <Button x:Name="ActualSizeButton" Style="{StaticResource Action}" ToolTip="Actual size (Ctrl+1). Ctrl+scroll to zoom.">
                        <TextBlock Style="{StaticResource Caption}" Text="100%" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource Caption}" Foreground="#99FFFFFF" MinWidth="44" Margin="6,0,0,0" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Border Padding="24">
                <Grid x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="SurfaceScale" />
                    </Grid.LayoutTransform>
                    <Grid x:Name="Layers" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="Picture" Stretch="Fill" />
                        <editor:CommittedMarksLayer x:Name="CommittedLayer" IsHitTestVisible="False" />
                        <editor:PreviewLayer x:Name="DrawingLayer" Cursor="Cross" />
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
